# Public build-time URL for the existing Neon Auth branch (not a secret).
VITE_NEON_AUTH_URL=https://your-branch.neonauth.example/database/auth

# Netlify Functions only. Use a pooled Neon connection for request traffic.
DATABASE_URL=postgresql://app_role:password@host-pooler/database?sslmode=require
NEON_AUTH_JWKS_URL=https://your-branch.neonauth.example/database/auth/.well-known/jwks.json
ADMIN_EMAIL=owner@example.com
# Optional local override. Production initializes its private key in Netlify Blobs.
# CREDENTIALS_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_BASE_URL=https://prospection-95.netlify.app
APP_TIMEZONE=Europe/Paris
OUTBOUND_ENABLED=false
